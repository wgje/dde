node_modules
dist
dist-ssr

# Environment files - SENSITIVE (DO NOT COMMIT!)
# These contain API keys and secrets
*.local
.env
.env.*
!.env.template
src/environments/environment.ts
src/environments/environment.development.ts

# Sentry CLI local credentials/defaults
.sentryclirc
sentry.properties

# Supabase local config
.supabase/

# Firebase / FCM (SENSITIVE - contains project identifiers)
# google-services.json is technically public (shipped in APK) but we keep it
# out of the repo to avoid leaking project IDs of per-environment Firebase
# projects. Place your file at android/app/google-services.json locally.
android/app/google-services.json

# Android 签名密钥 - SENSITIVE (DO NOT COMMIT!)
# 发布签名的 keystore 与密码绝不能进入仓库
*.jks
*.keystore
keystore.properties

# Cloudflare Workers (Wrangler) - 本地状态与开发密钥
.wrangler/
.dev.vars
.dev.vars.*

