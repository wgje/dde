# NanoFlow 环境变量模板
# 复制此文件为 .env.local 并填入你的实际值
# .env.local 已添加到 .gitignore，不会被提交到代码仓库

# ========== Supabase 配置（必需）==========
# 从 Supabase Dashboard > Project Settings > API 获取
# 详细配置教程：https://github.com/dydyde/dde#supabase-部署配置
NG_APP_SUPABASE_URL=https://your-project.supabase.co
NG_APP_SUPABASE_ANON_KEY=your-anon-key

# ========== Supabase CLI（可选，本地/CI 管理用）==========
# 从 Supabase Dashboard > Project Settings > General 获取 Project ref
SUPABASE_PROJECT_REF=your-project-ref
# 从 Supabase Dashboard > Account > Access Tokens 创建；只放 .env.local 或 CI Secret
SUPABASE_ACCESS_TOKEN=

# ========== Sentry 错误监控（可选）==========
# 从 Sentry Dashboard > Project Settings > Client Keys (DSN) 获取
# 格式: https://xxx@xxx.ingest.sentry.io/xxx
NG_APP_SENTRY_DSN=

# ========== Sentry CLI（可选，release/source map 上传用）==========
# 从 Sentry URL 中可见 org/project slug；token 只放 .env.local 或 CI Secret
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=
# 运行时 release 会规范化为 nanoflow@<value>，保持与 Sentry 初始化一致
SENTRY_RELEASE=
# 默认 dist/browser
SENTRY_SOURCEMAP_DIR=dist/browser

# ========== GoJS License（可选）==========
# 生产环境需要配置以移除水印
NG_APP_GOJS_LICENSE_KEY=

# ========== Demo 模式（可选）==========
# 设置为 true 启用 Demo 模式限制（项目数量限制、显示 Demo Banner）
# 通常用于公共演示实例
NG_APP_DEMO_MODE=false

# ========== Offline-first 同步保护（可选）==========
# 默认启用跨标签 single-writer lease；仅在排障或临时降级时显式设为 false
NG_APP_SYNC_LEASE_ENABLED=true

# ========== 开发环境自动登录（可选）==========
# 仅在开发环境使用，设置后应用启动时会自动登录
# NG_APP_DEV_AUTO_LOGIN_EMAIL=dev@example.com
# NG_APP_DEV_AUTO_LOGIN_PASSWORD=your-dev-password

# ========== 认证态性能门禁（可选，本地/CI perf E2E 用）==========
# 运行 npm run test:e2e:perf 生成 test-results/perf/current-metrics.json 时必需
# 只放 .env.local 或 CI Secret，不要提交真实凭据
E2E_PERF_EMAIL=perf-user@example.com
E2E_PERF_PASSWORD=your-perf-user-password
# 可选：固定认证后进入的项目，减少 perf 样本漂移
E2E_PERF_PROJECT_ID=
