{
  "version": 1,
  "description": "将用户可感知的实现区域绑定到对应的中文 handbook 页面；命中触发路径的变更必须在同一变更中更新至少一篇绑定页面。",
  "routes": [
    {
      "id": "workspace-startup-and-session",
      "description": "启动、登录、会话恢复、侧栏壳层和状态提示会改变用户进入应用与判断当前状态的方式。",
      "triggers": [
        "src/workspace-shell.component.ts",
        "src/app/core/shell/**",
        "src/app/core/services/app-auth-coordinator.service.ts",
        "src/services/auth-*.ts",
        "src/services/user-session-*.ts",
        "src/services/session-runtime-reset.*",
        "src/app/shared/modals/login-modal.component.ts",
        "src/app/shared/components/reset-password.component.ts",
        "src/services/app-lifecycle-*.ts"
      ],
      "handbook": [
        "docs/handbook/01-get-started/05-startup-login-and-status.md"
      ]
    },
    {
      "id": "local-only-workspace",
      "description": "本地模式访问、当前浏览器数据隔离和 Demo 模式提示会改变用户判断数据保存范围、登录切换和恢复准备的方式。",
      "triggers": [
        "src/services/guards/auth.guard.ts",
        "src/services/auth-storage-bridge.controller.ts",
        "src/app/shared/components/demo-banner.component.ts"
      ],
      "handbook": [
        "docs/handbook/01-get-started/02-local-only-mode.md"
      ]
    },
    {
      "id": "local-development-startup",
      "description": "本地开发服务器的启动、端口选择和环境生成会改变使用者打开应用和判断运行实例的方式。",
      "triggers": [
        "scripts/run-ng.cjs",
        "scripts/dev-server-port.cjs",
        "scripts/set-env.cjs"
      ],
      "handbook": [
        "docs/handbook/01-get-started/01-quickstart.md"
      ]
    },
    {
      "id": "text-task-workflow",
      "description": "任务创建、编辑、移动、撤销和文本视图交互会改变日常任务管理流程。",
      "triggers": [
        "src/app/features/text/**",
        "src/services/task-*.ts",
        "src/services/project-operation*.ts",
        "src/services/undo.service.ts"
