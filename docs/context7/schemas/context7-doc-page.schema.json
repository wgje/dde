{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoflow.local/schemas/context7-doc-page.schema.json",
  "title": "NanoFlow Context7 Markdown Page Metadata",
  "type": "object",
  "required": [
    "title",
    "status",
    "audience",
    "last_verified",
    "source_paths"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "canonical",
        "accepted",
        "draft"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 3
    },
    "last_verified": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
