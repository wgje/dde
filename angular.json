{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "",
  "projects": {
    "app": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": ".",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": {
              "input": ".tmp/index.generated.html",
              "output": "index.html"
            },
            "browser": "main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/styles/global-interaction-overrides.css"
            ],
            "define": {
              "import.meta.env.NG_APP_SUPABASE_URL": "process.env.NG_APP_SUPABASE_URL",
              "import.meta.env.NG_APP_SUPABASE_ANON_KEY": "process.env.NG_APP_SUPABASE_ANON_KEY"
            },
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "aot": true,
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": {
                  "inline": false
                }
              },
              "namedChunks": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "520kb",
                  "maximumError": "800kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "20kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "hmr": false
          },
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "94f6abed-3de0-4622-98ce-f86b7c522b5b"
  }
}
